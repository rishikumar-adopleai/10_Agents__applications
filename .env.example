# ==============================================================================
# Enterprise Sales Agent Platform - Environment Configuration Example
# Copy this file to .env and fill in required values for your environment.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="Enterprise Sales Agent Platform"
APP_SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars-long
APP_PORT=8001
APP_HOST=0.0.0.0
DEBUG=true

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sales_agent_platform
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_DEFAULT_QUEUE=default

# Authentication & Security
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CSRF_SECRET_KEY=change-me-to-a-secure-random-csrf-secret-key-32-chars

# CORS Configuration (JSON-encoded list or comma-separated URLs)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8001

# Logging & Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_AUTH="10/minute"
RATE_LIMIT_EXPENSIVE_AGENT="15/minute"

# AI Provider Gateway
AI_PROVIDER=openai
OPENAI_API_KEY=mock-or-real-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

# Research Provider (Apollo)
APOLLO_API_KEY=mock-or-real-apollo-api-key
APOLLO_BASE_URL=https://api.apollo.io/v1

# CRM Providers
HUBSPOT_ACCESS_TOKEN=mock-or-real-hubspot-token
HUBSPOT_BASE_URL=https://api.hubapi.com
GHL_ACCESS_TOKEN=mock-or-real-ghl-token
GHL_LOCATION_ID=mock-location-id
GHL_BASE_URL=https://services.leadconnectorhq.com

# Messaging Provider (SMS)
SMS_PROVIDER=mock
SMS_PROVIDER_API_KEY=mock-sms-provider-key
SMS_PROVIDER_PHONE_NUMBER=+15551234567
SMS_WEBHOOK_SECRET=mock-sms-webhook-secret

# Calendar Provider (Microsoft Graph)
MICROSOFT_CLIENT_ID=mock-ms-client-id
MICROSOFT_CLIENT_SECRET=mock-ms-client-secret
MICROSOFT_TENANT_ID=mock-ms-tenant-id

# Object Storage (S3 / MinIO compatible)
OBJECT_STORAGE_PROVIDER=mock
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=sales-agent-artifacts
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false




# Pipeline 2 test settings
PIPELINE2_INPUT_MODE=mock
RESEARCH_PROVIDER=mock
CONTACT_PROVIDER=mock
ENABLE_MESSAGE_SENDING=false

# Later for live research
BRAVE_SEARCH_API_KEY=
APOLLO_API_KEY=
